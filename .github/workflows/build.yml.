name: Build APK

on:
  push:
    branches: [main, master]
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Unpack project zip (if the project was uploaded as a zip)
        run: |
          if [ -f zircut_project.zip ]; then
            unzip -o zircut_project.zip
          fi
          test -f settings.gradle.kts

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: android-actions/setup-android@v3

      - name: Install SDK, NDK and CMake
        run: |
          yes | sdkmanager --licenses > /dev/null || true
          sdkmanager --install "platforms;android-34" "build-tools;34.0.0" "ndk;26.3.11579264" "cmake;3.22.1"

      - name: Fetch whisper.cpp
        run: git clone --depth 1 --branch v1.7.2 https://github.com/ggerganov/whisper.cpp app/src/main/cpp/whisper.cpp

      - name: Fetch Vazirmatn font
        run: |
          mkdir -p app/src/main/assets/fonts
          for f in Regular Bold; do
            curl -fL -o app/src/main/assets/fonts/Vazirmatn-$f.ttf \
              https://github.com/rastikerdar/vazirmatn/raw/master/fonts/ttf/Vazirmatn-$f.ttf || echo "font $f skipped"
          done
          ls -la app/src/main/assets/fonts

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"

      - name: Build release APK
        run: gradle :app:assembleRelease --no-daemon --stacktrace

      - name: Rename APK
        run: cp app/build/outputs/apk/release/app-release.apk ZirCut.apk

      - uses: actions/upload-artifact@v4
        with:
          name: ZirCut-apk
          path: ZirCut.apk

      - name: Publish release (tags only)
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: ZirCut.apk
